          "jsonOutput": "{\n  \"metrics\": [\n    { \"metric\": \"revenue_consolidated\", \"unit\": \"INR crore\", \"description\": \"Total consolidated revenue from operations for the full financial year 2025-26, in INR crore\" },\n    { \"metric\": \"net_profit_consolidated\", \"unit\": \"INR crore\", \"description\": \"Consolidated net profit (profit for the year) for financial year 2025-26, in INR crore\" },\n    { \"metric\": \"operating_margin\", \"unit\": \"%\", \"description\": \"Operating margin (operating profit as a percentage of revenue) for financial year 2025-26\" },\n    { \"metric\": \"earnings_per_share\", \"unit\": \"INR\", \"description\": \"Basic earnings per share for financial year 2025-26, in INR\" },\n    { \"metric\": \"dividend_per_share\", \"unit\": \"INR\", \"description\": \"Total dividend per share declared for financial year 2025-26, in INR\" },\n    { \"metric\": \"total_employees\", \"unit\": \"count\", \"description\": \"Total number of employees at the end of financial year 2025-26\" },\n    { \"metric\": \"attrition_rate\", \"unit\": \"%\", \"description\": \"Employee attrition or turnover rate for financial year 2025-26\" },\n    { \"metric\": \"women_employees_pct\", \"unit\": \"%\", \"description\": \"Percentage of women in the total workforce at the end of financial year 2025-26\" }\n  ]\n}",
          "includeOtherFields": true,
          "options": {}
        },
