        "position": [
          16,
          -16
        ]
      },
      {
        "parameters": {
          "content": "### Retrieval\nFetch 20 chunks from Pinecone, rerank with Cohere, keep top 5.\nEmbedding model MUST match ingestion: text-embedding-3-small.",
