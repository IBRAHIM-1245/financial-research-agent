            "cachedResultName": "gpt-4o-mini"
          },
          "builtInTools": {},
          "options": {
            "textFormat": {
              "textOptions": {
                "type": "json_schema",
                "name": "verification_result",
                "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"supported\": { \"type\": \"boolean\" },\n    \"confidence\": { \"type\": \"number\" },\n    \"unsupported_claims\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"reason\": { \"type\": \"string\" }\n  },\n  \"required\": [\"supported\", \"confidence\", \"unsupported_claims\", \"reason\"],\n  \"additionalProperties\": false\n}"
              }
            },
            "temperature": 0
          }
