      {
        "parameters": {
          "descriptionType": "manual",
          "toolDescription": "Runs one read-only SQL SELECT on the table verified_metrics, which holds exact, human-verified 2025-26 figures.\nColumns: company ('TCS','Infosys','Wipro'), ticker, fiscal_year ('2025-26'), metric, value, unit, source_page.\nMetrics: revenue_consolidated (INR crore), net_profit_consolidated (INR crore), operating_margin (%), earnings_per_share (INR), dividend_per_share (INR), total_employees (count), attrition_rate (%), women_employees_pct (%).\nUse this for any number or comparison of these metrics. Always select company, metric, value, unit and source_page.",
          "operation": "executeQuery",
          "query": "{{ $fromAI('sql_query', 'One PostgreSQL SELECT on verified_metrics. It MUST select company, metric, value, unit, source_page', 'string') }}",
          "options": {}
        },
